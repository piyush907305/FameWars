{
  "name": "fame-wars",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write packages tests *.ts *.json",
    "sim": "node scripts/run-sim.mjs sim-demo",
    "check:architecture": "node scripts/check-architecture.mjs",
    "benchmark": "node scripts/run-sim.mjs sim-benchmark",
    "record:replay": "node scripts/run-sim.mjs record-replay",
    "test:replay": "vitest run packages/sim/src/replay.test.ts",
    "test:e2e:smoke": "playwright test --grep-invert @full-match",
    "test:e2e:full": "playwright test --grep @full-match",
    "record:replay:10000": "node scripts/run-sim.mjs record-replay-10000"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "three": "0.187.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7",
    "tsx": "4.20.6"
  },
  "type": "module"
}
